# Paths are deliberately external: sensitive data and weights are not in Git.
# Point DXY_DATA_ROOT at a directory holding the named input subdirectories.
export DXY_DATA_ROOT=/path/to/dxy-data
export DXY_VIDEO_DIR=/path/to/raw-videos
export DXY_MODEL_DIR=/path/to/init-segmentation-model

# Optional: override an experiment input/output location.
# export DXY_AUDIT_ROOT="$DXY_DATA_ROOT/scale_video_audit"
# export DXY_RAW_SELECTOR_ROOT="$DXY_DATA_ROOT/raw_selector"
# export DXY_AREA_GUARD_ROOT="$DXY_DATA_ROOT/area_guard"
# export DXY_PRIOR_SELECTOR_ROOT="$DXY_DATA_ROOT/prior_selector"
# export DXY_OUTPUT_ROOT=/path/to/writeable-output
